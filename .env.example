# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000

# Security & JWT Auth
JWT_SECRET=flashsale-super-secret-key-change-in-prod-2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Redis In-Memory Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RESERVED=orders.reserved
KAFKA_TOPIC_DLQ=orders.dlq
KAFKA_CONSUMER_GROUP=flashsale-order-workers

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=flashsale_db
POSTGRES_USER=flashsale_user
POSTGRES_PASSWORD=flashsale_secure_password_2026
DATABASE_URL=postgresql+asyncpg://flashsale_user:flashsale_secure_password_2026@postgres:5432/flashsale_db

